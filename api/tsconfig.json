{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "outDir": "dist",
    "rootDir": "..",
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "react": [
        "./node_modules/@types/react/index.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "../src/types.ts",
    "../src/lib/dates.ts",
    "../src/lib/rates.ts",
    "../src/lib/earnings.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts"
  ]
}
