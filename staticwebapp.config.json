{
  "routes": [
    {
      "route": "/api/mcp",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/oauth/*",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/.well-known/oauth-protected-resource*",
      "rewrite": "/api/oauth/protected-resource"
    },
    {
      "route": "/.well-known/oauth-authorization-server*",
      "rewrite": "/api/oauth/metadata"
    },
    {
      "route": "/api/*",
      "allowedRoles": ["owner"]
    }
  ],
  "platform": {
    "apiRuntime": "node:22"
  },
  "globalHeaders": {
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains; preload",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
    "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://*.blob.core.windows.net; connect-src 'self' https://*.blob.core.windows.net; font-src 'self' https://fonts.gstatic.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/.well-known/*", "/assets/*", "/*.{png,jpg,jpeg,svg,ico,css,js,json}"]
  }
}
